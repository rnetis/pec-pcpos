{
  "name": "pec-pcpos",
  "version": "1.0.0",
  "description": "Pure-Node.js reimplementation of the Intek.PcPosLibrary + PEC PCPOS Windows Service protocol bridge. Reverse-engineered from Pec-PCPOS-WindowsService.exe (Copyright © 2017).",
  "license": "MIT",
  "keywords": [
    "pec",
    "pcpos",
    "intek",
    "pos",
    "payment",
    "iran",
    "terminal",
    "eftpos",
    "parsian"
  ],
  "author": "",
  "homepage": "https://github.com/your-org/pec-pcpos",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pec-pcpos.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  }
}
